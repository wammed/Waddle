{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waddle",
  "version": "0.1.0",
  "identifier": "com.waddle.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waddle -- The AI Powered Terminal --",
        "width": 1700,
        "height": 1440,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://localhost:11434 http://127.0.0.1:11434 https://api.github.com https://github.com;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPCONFIG/**/*",
            "$CONFIG/waddle/**/*",
            "$PICTURE/*",
            "$PICTURE/**/*",
            "$HOME/Pictures/*",
            "$HOME/Pictures/**/*",
            "$DOWNLOAD/*",
            "$DOWNLOAD/**/*",
            "$HOME/Downloads/*",
            "$HOME/Downloads/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}