{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waddle",
  "version": "0.1.0",
  "identifier": "com.waddle.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waddle",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*",
            "$HOME/**/*",
            "$APPDATA/**/*",
            "$PICTURES/**/*",
            "$CONFIG/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
